TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ALLOWED_USER_IDS=

# По умолчанию бот принимает записи только в личном диалоге.
TELEGRAM_BOT_PRIVATE_ONLY=1
TELEGRAM_BOT_CODEX_TIMEOUT_SECONDS=300
TELEGRAM_BOT_MAX_ATTEMPTS=3
TELEGRAM_BOT_MAX_INPUT_CHARS=4000
TELEGRAM_BOT_LOG_INPUT=1
TELEGRAM_BOT_VOICE_TIMEOUT_SECONDS=300
TELEGRAM_BOT_MAX_VOICE_SECONDS=120

# Необязательные переопределения:
# TELEGRAM_BOT_API_URL=https://api.telegram.org
# TELEGRAM_BOT_STATE_FILE=/home/user/.local/state/aitools/telegram-spendee-bot/state.json
# TELEGRAM_BOT_SKILL_PATH=/home/user/.codex/skills/spendee-add-transaction/SKILL.md
# TELEGRAM_BOT_OUTPUT_SCHEMA=/path/to/mcp-spendee/config/telegram-output.schema.json
# TELEGRAM_BOT_FFMPEG_BIN=ffmpeg
# TELEGRAM_BOT_WHISPER_BIN=/home/user/.local/share/telegram-spendee-bot/whisper.cpp/build/bin/whisper-cli
# TELEGRAM_BOT_WHISPER_MODEL=/home/user/.local/share/telegram-spendee-bot/whisper.cpp/models/ggml-base.bin
# CODEX_BIN=codex
