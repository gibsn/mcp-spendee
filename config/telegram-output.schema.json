{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "message", "error"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["logged", "needs_input", "error"]
    },
    "message": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  }
}
