[Unit]
Description=Telegram to Spendee transaction bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=@HOME@
Environment=CODEX_HOME=@CODEX_HOME@
Environment=TELEGRAM_BOT_REPO=@BOT_REPO@
Environment=TELEGRAM_BOT_STATE_FILE=@STATE_FILE@
EnvironmentFile=@ENV_FILE@
ExecStart=@BINARY@
Restart=on-failure
RestartSec=10
TimeoutStopSec=45

[Install]
WantedBy=default.target
